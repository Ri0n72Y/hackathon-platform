# Experimental Bot-only identity check on the current repository.
# NEVER commit real credentials. Populate these in Vercel settings.
GITHUB_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_PEM\n-----END RSA PRIVATE KEY-----
GITHUB_INSTALLATION_ID=REPLACE_WITH_INSTALLATION_ID
POC_CHECK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# User OAuth proof is still separate; it will require a Client ID,
# Client Secret, callback URL and a secure session implementation.
